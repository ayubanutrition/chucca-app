{
  "name": "chucca-app",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:public": "CHUCCA_MODE=public astro build --outDir dist-public",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build:test && npm run test:e2e",
    "build:test": "astro build && CHUCCA_MODE=public CHUCCA_SITE_URL=https://chucca.example astro build --outDir dist-public && CHUCCA_MODE=public CHUCCA_SITE_URL=https://chucca.example CHUCCA_BASE=/preview/app/ astro build --outDir dist-sub",
    "serve": "node scripts/serve.mjs dist 4321",
    "media:audit": "vitest run tests/unit/content-media.test.ts"
  },
  "dependencies": {
    "astro": "^7.4.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
