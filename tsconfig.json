{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "tests", "integrations", "scripts", "*.ts", "*.mjs"],
  "exclude": ["dist", "dist-public", "dist-sub", "dist-hours", "dist-inquiry", "dist-menu", "dist-update", "node_modules"],
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": false
  }
}
