{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src", "tests", "integrations", "scripts", "*.ts", "*.mjs"],
  "exclude": ["dist", "dist-public", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "resolveJsonModule": true,
    "exactOptionalPropertyTypes": false
  }
}
